require 'fileutils'
require 'webrick'

desc "Запуск юнит-тестов D-ядра"
task :test do
  sh "dub test"
end

desc "Сборка нативной библиотеки (DLL/SO) и WebAssembly модуля"
task :build do
  FileUtils.mkdir_p("build")
  FileUtils.mkdir_p("web")

  puts "1. Сборка нативной библиотеки через DUB..."
  sh "dub build --compiler=ldc2"

  puts "2. Сборка WebAssembly модуля (web/engine.wasm)..."
  sh "ldc2 -mtriple=wasm32-unknown-unknown-wasm -betterC -release -O3 -I=source -L--no-entry -L--export-all source/holomorphic/core.d source/holomorphic/vision.d source/holomorphic/capi.d -of=web/engine.wasm"
end

desc "Тест нативного вызова D из Ruby (FFI)"
task :ruby_demo => :build do
  sh "ruby ruby/holomorphic_vis.rb"
end

desc "Запуск интерактивного веб-стенда"
task :serve => :build do
  server = WEBrick::HTTPServer.new(Port: 8080, DocumentRoot: File.expand_path("web"), Logger: WEBrick::Log.new(File::NULL), AccessLog: [])
  trap('INT') { server.shutdown }
  puts "Стенд запущен на http://localhost:8080"
  server.start
end

task :default => :build
